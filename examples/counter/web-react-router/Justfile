mod lib '../../../lib.just'

default: dev

# --------------------------------------------------------------------------
# Development
# --------------------------------------------------------------------------

# checks required tools are installed
doctor:
    @echo '{{ style("command") }}doctor:{{ NORMAL }}'
    @just lib::check-web-wasm

# auto-fix lint issues
fix: typegen install wasm
    @echo '{{ style("command") }}fix:{{ NORMAL }}'
    node_modules/.bin/oxlint --fix

# validate lint with type-aware Oxlint (warnings do not fail the check, but
# errors do). The type information comes from node_modules and the generated
# packages. `pnpm exec` installs again on each run because of the `link:`
# dependency, so the recipes run Oxlint from node_modules/.bin.
check: typegen install wasm
    @echo '{{ style("command") }}check:{{ NORMAL }}'
    node_modules/.bin/oxlint

# generate types for typescript
typegen:
    @echo '{{ style("command") }}typegen:{{ NORMAL }}'
    RUST_LOG=info cargo run \
        --package shared \
        --bin codegen \
        --features codegen,facet_typegen \
        -- \
            --language typescript \
            --output-dir generated/types

# build wasm package (`boltffi pack wasm` type-checks the bindings against
# `@boltffi/runtime` and `@types/node` in this shell's node_modules, so the
# install runs first)
[working-directory('../shared')]
wasm: install
    @echo '{{ style("command") }}wasm:{{ NORMAL }}'
    boltffi --overlay boltffi.web-react-router.toml pack wasm

# install npm dependencies
install:
    @echo '{{ style("command") }}install:{{ NORMAL }}'
    pnpm install

# build the project
build: typegen install wasm
    @echo '{{ style("command") }}build:{{ NORMAL }}'
    pnpm build

# run tests
test:
    @echo '{{ style("command") }}test:{{ NORMAL }}'
    @echo "  No tests configured"

# clean build artifacts
clean:
    @echo '{{ style("command") }}clean:{{ NORMAL }}'
    cargo clean
    rm -rf generated .react-router node_modules

# update pnpm dependencies to latest
update-pnpm-deps: typegen wasm
    @echo '{{ style("command") }}update-pnpm-deps:{{ NORMAL }}'
    pnpm update

# local development workflow
dev: fix check build test

# CI workflow
ci: check build test

# serve the app locally
serve: typegen install wasm
    @echo '{{ style("command") }}serve:{{ NORMAL }}'
    pnpm dev
