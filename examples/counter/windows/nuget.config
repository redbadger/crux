<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds a local NuGet feed at generated/nuget so MSBuild can restore
  CounterApp.Shared.Ffi (built and packed by `boltffi pack csharp`).
  Keep nuget.org explicit so clean Windows ARM64 restores do not depend on
  machine-level NuGet source configuration.
-->
<configuration>
  <packageSources>
    <add key="boltffi-local" value="generated/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
