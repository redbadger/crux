# check formatting and lint in all shells
[unix]
[script('bash')]
check:
    set -euo pipefail
    for shell in {{ shells }}; do
        echo '{{ style("command") }}'"$shell"'/check:{{ NORMAL }}'
        just "$shell/check"
    done

[windows]
[script('powershell')]
check:
    foreach ($shell in "{{ shells }}".Split(" ")) {
