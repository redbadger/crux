mod lib '../../lib.just'

default: dev

# The command interpreter just uses on Windows. Unrelated to the Crux shells
# below — and note one of those is itself called "windows".
set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

# The Crux shells: the platform-specific UI layers wrapping the shared core,
# each a subdirectory with its own Justfile.
crux_shells_common := "shared tui web-leptos web-yew web-dioxus web-nextjs web-react-router tauri android"
crux_shells := if os() == "macos" { crux_shells_common + " apple" } else if os() == "windows" { crux_shells_common + " windows" } else { crux_shells_common }
pnpm_crux_shells := "web-nextjs web-react-router tauri"

# checks required tools across all Crux shells
[unix]
[script('bash')]
doctor:
    for crux_shell in {{ crux_shells }}; do
        echo '{{ style("command") }}'"$crux_shell"':{{ NORMAL }}'
        just "$crux_shell/doctor"
        echo ''
    done

# no early exit: report every Crux shell's tool status, like the bash version
[windows]
[script('powershell')]
doctor:
    foreach ($crux_shell in "{{ crux_shells }}".Split(" ")) {
        if ($crux_shell) {
            Write-Host "{{ style("command") }}${crux_shell}:{{ NORMAL }}"
            just "$crux_shell/doctor"
            Write-Host ""
        }
    }

# local development workflow
[unix]
[script('bash')]
dev:
    set -euo pipefail
    for crux_shell in {{ crux_shells }}; do
        echo '{{ style("command") }}'"$crux_shell"'/dev:{{ NORMAL }}'
        just "$crux_shell/dev"
    done

[windows]
[script('powershell')]
dev:
    $ErrorActionPreference = 'Stop'
    foreach ($crux_shell in "{{ crux_shells }}".Split(" ")) {
        if ($crux_shell) {
            Write-Host "{{ style("command") }}$crux_shell/dev:{{ NORMAL }}"
            just "$crux_shell/dev"
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        }
    }

