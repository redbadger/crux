# The command interpreter just uses on Windows. Unrelated to the Crux shells
# below — and note one of those is itself called "windows".
set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

mod lib '../../lib.just'

default: dev

# The Crux shells: the platform-specific UI layers wrapping the shared core.
# `apple` and `windows` only build on their own platform.
crux_shells_common := "tui web-leptos web-yew web-dioxus web-nextjs web-react-router tauri Android"
crux_shells := if os() == "macos" { crux_shells_common + " apple" } else if os() == "windows" { crux_shells_common + " windows" } else { crux_shells_common }
pnpm_crux_shells := "web-nextjs web-react-router tauri"

# Every subdirectory with its own Justfile: the shared core is not a shell, but
# the aggregate recipes below drive it the same way. Core first, so a broken
# core fails before any shell tries to build against it.
subprojects := "shared " + crux_shells

# checks required tools across the core and all Crux shells
[unix]
[script('bash')]
doctor:
    for subproject in {{ subprojects }}; do
        echo '{{ style("command") }}'"$subproject"':{{ NORMAL }}'
        just "$subproject/doctor"
        echo ''
    done

# no early exit: report every subproject's tool status, like the bash version
[windows]
[script('powershell')]
doctor:
    foreach ($subproject in "{{ subprojects }}".Split(" ")) {
        if ($subproject) {
            Write-Host "{{ style("command") }}${subproject}:{{ NORMAL }}"
            just "$subproject/doctor"
            Write-Host ""
        }
    }

# local development workflow
[unix]
[script('bash')]
dev:
    set -euo pipefail
    for subproject in {{ subprojects }}; do
        echo '{{ style("command") }}'"$subproject"'/dev:{{ NORMAL }}'
        just "$subproject/dev"
    done

[windows]
[script('powershell')]
dev:
    $ErrorActionPreference = 'Stop'
    foreach ($subproject in "{{ subprojects }}".Split(" ")) {
        if ($subproject) {
            Write-Host "{{ style("command") }}$subproject/dev:{{ NORMAL }}"
            just "$subproject/dev"
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        }
    }

# fix formatting in the core and all Crux shells
[unix]
[script('bash')]
fix:
    set -euo pipefail
    for subproject in {{ subprojects }}; do
        echo '{{ style("command") }}'"$subproject"'/fix:{{ NORMAL }}'
        just "$subproject/fix"
