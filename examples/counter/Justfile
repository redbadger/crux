# update pnpm dependencies in all pnpm Crux shells
[unix]
[script('bash')]
update-pnpm-deps:
    set -euo pipefail
    for crux_shell in {{ pnpm_crux_shells }}; do
        echo '{{ style("command") }}'"$crux_shell"'/update-pnpm-deps:{{ NORMAL }}'
        just "$crux_shell/update-pnpm-deps"
    done

[windows]
[script('powershell')]
update-pnpm-deps:
    $ErrorActionPreference = 'Stop'
    foreach ($crux_shell in "{{ pnpm_crux_shells }}".Split(" ")) {
        if ($crux_shell) {
            Write-Host "{{ style("command") }}$crux_shell/update-pnpm-deps:{{ NORMAL }}"
            just "$crux_shell/update-pnpm-deps"
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        }
    }
