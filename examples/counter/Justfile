# check formatting and lint in all Crux shells
[unix]
[script('bash')]
check:
    set -euo pipefail
    for crux_shell in {{ crux_shells }}; do
        echo '{{ style("command") }}'"$crux_shell"'/check:{{ NORMAL }}'
        just "$crux_shell/check"
    done

[windows]
[script('powershell')]
check:
    $ErrorActionPreference = 'Stop'
    foreach ($crux_shell in "{{ crux_shells }}".Split(" ")) {
        if ($crux_shell) {
            Write-Host "{{ style("command") }}$crux_shell/check:{{ NORMAL }}"
            just "$crux_shell/check"
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        }
    }

# clean build artefacts in all Crux shells
[unix]
[script('bash')]
clean:
    set -euo pipefail
    for crux_shell in {{ crux_shells }}; do
        echo '{{ style("command") }}'"$crux_shell"'/clean:{{ NORMAL }}'
        just "$crux_shell/clean"
    done
    cargo clean
    rm -rf target

[windows]
[script('powershell')]
clean:
    $ErrorActionPreference = 'Stop'
    foreach ($crux_shell in "{{ crux_shells }}".Split(" ")) {
        if ($crux_shell) {
            Write-Host "{{ style("command") }}$crux_shell/clean:{{ NORMAL }}"
            just "$crux_shell/clean"
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        }
    }
    cargo clean
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    if (Test-Path target) { Remove-Item -Recurse -Force target }

