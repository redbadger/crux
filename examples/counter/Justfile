# check formatting and lint in the core and all Crux shells
[unix]
[script('bash')]
check:
    set -euo pipefail
    for subproject in {{ subprojects }}; do
        echo '{{ style("command") }}'"$subproject"'/check:{{ NORMAL }}'
        just "$subproject/check"
    done

[windows]
[script('powershell')]
check:
    $ErrorActionPreference = 'Stop'
    foreach ($subproject in "{{ subprojects }}".Split(" ")) {
        if ($subproject) {
            Write-Host "{{ style("command") }}$subproject/check:{{ NORMAL }}"
            just "$subproject/check"
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        }
    }

# clean build artefacts in the core and all Crux shells
[unix]
[script('bash')]
clean:
    set -euo pipefail
    for subproject in {{ subprojects }}; do
        echo '{{ style("command") }}'"$subproject"'/clean:{{ NORMAL }}'
        just "$subproject/clean"
    done
    cargo clean
    rm -rf target

[windows]
[script('powershell')]
clean:
    $ErrorActionPreference = 'Stop'
    foreach ($subproject in "{{ subprojects }}".Split(" ")) {
        if ($subproject) {
            Write-Host "{{ style("command") }}$subproject/clean:{{ NORMAL }}"
            just "$subproject/clean"
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        }
    }
    cargo clean
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    if (Test-Path target) { Remove-Item -Recurse -Force target }

# CI workflow
