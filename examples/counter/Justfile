mod lib '../../lib.just'

default: dev

set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

common := "shared tui web-leptos web-yew web-dioxus web-nextjs web-react-router tauri android"
shells := if os() == "macos" { common + " apple" } else if os() == "windows" { common + " windows" } else { common }

# checks required tools across all shells
[unix]
[script('bash')]
doctor:
    for shell in {{ shells }}; do
        echo '{{ style("command") }}'"$shell"':{{ NORMAL }}'
        just "$shell/doctor"
        echo ''
    done

[windows]
[script('powershell')]
doctor:
    foreach ($shell in "{{ shells }}".Split(" ")) {
        if ($shell) {
            Write-Host "{{ style("command") }}${shell}:{{ NORMAL }}"
            just "$shell/doctor"
            Write-Host ""
        }
    }

# local development workflow
[unix]
[script('bash')]
dev:
    set -euo pipefail
    for shell in {{ shells }}; do
        echo '{{ style("command") }}'"$shell"'/dev:{{ NORMAL }}'
        just "$shell/dev"
    done

[windows]
[script('powershell')]
dev:
    foreach ($shell in "{{ shells }}".Split(" ")) {
        if ($shell) {
            Write-Host "{{ style("command") }}$shell/dev:{{ NORMAL }}"
            just "$shell/dev"
        }
    }

