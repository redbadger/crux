        }
    }

# clean build artefacts in all shells
[unix]
[script('bash')]
clean:
    set -euo pipefail
    for shell in {{ shells }}; do
        echo '{{ style("command") }}'"$shell"'/clean:{{ NORMAL }}'
        just "$shell/clean"
    done
    cargo clean
    rm -rf target

[windows]
[script('powershell')]
clean:
    foreach ($shell in "{{ shells }}".Split(" ")) {
        if ($shell) {
            Write-Host "{{ style("command") }}$shell/clean:{{ NORMAL }}"
            just "$shell/clean"
        }
    }
    cargo clean
    if (Test-Path target) { Remove-Item -Recurse -Force target }

# CI workflow
[unix]
[script('bash')]
ci:
    set -euo pipefail
    for shell in {{ shells }}; do
        echo '{{ style("command") }}'"$shell"'/ci:{{ NORMAL }}'
        just "$shell/ci"
    done

