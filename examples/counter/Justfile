# clean build artefacts in all shells
[unix]
[script('bash')]
clean:
    set -euo pipefail
    for shell in {{ shells }}; do
        echo '{{ style("command") }}'"$shell"'/clean:{{ NORMAL }}'
        just "$shell/clean"
    done
    cargo clean
    rm -rf target

[windows]
[script('powershell')]
clean:
    $ErrorActionPreference = 'Stop'
    foreach ($shell in "{{ shells }}".Split(" ")) {
        if ($shell) {
            Write-Host "{{ style("command") }}$shell/clean:{{ NORMAL }}"
            just "$shell/clean"
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        }
    }
    cargo clean
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    if (Test-Path target) { Remove-Item -Recurse -Force target }

