# update pnpm dependencies in all pnpm shells
[unix]
[script('bash')]
update-pnpm-deps:
    set -euo pipefail
    for shell in web-nextjs web-react-router tauri; do
        echo '{{ style("command") }}'"$shell"'/update-pnpm-deps:{{ NORMAL }}'
        just "$shell/update-pnpm-deps"
    done

[windows]
[script('powershell')]
update-pnpm-deps:
    foreach ($shell in "web-nextjs web-react-router tauri".Split(" ")) {
        if ($shell) {
            Write-Host "{{ style("command") }}$shell/update-pnpm-deps:{{ NORMAL }}"
            just "$shell/update-pnpm-deps"
        }
    }
