set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

mod lib '../../../lib.just'

default: dev

gradlew := if os() == "windows" { "./gradlew.bat" } else { "./gradlew" }

# --------------------------------------------------------------------------
# Development
# --------------------------------------------------------------------------

# checks required tools are installed
doctor:
    @echo '{{ style("command") }}doctor:{{ NORMAL }}'
    @just lib::check-android

# install Android Rust cross-compilation targets
[unix]
install-targets:
    @echo '{{ style("command") }}install-targets:{{ NORMAL }}'
    TOOLCHAIN="${RUSTUP_TOOLCHAIN:-$(rustup show active-toolchain | awk '{print $1}')}" ; \
    echo "  Toolchain: $TOOLCHAIN" ; \
    rustup target add --toolchain "$TOOLCHAIN" \
        aarch64-linux-android \
        armv7-linux-androideabi \
        i686-linux-android \
        x86_64-linux-android

[windows]
[script('powershell')]
install-targets:
    Write-Host "{{ style("command") }}install-targets:{{ NORMAL }}"
    $toolchain = $env:RUSTUP_TOOLCHAIN
    if (-not $toolchain) {
        $active = rustup show active-toolchain
        $toolchain = ($active -split ' ')[0]
    }
    Write-Host "  Toolchain: $toolchain"
    rustup target add --toolchain "$toolchain" aarch64-linux-android armv7-linux-androideabi i686-linux-android x86_64-linux-android

# auto-fix formatting issues
fix:
    @echo '{{ style("command") }}fix:{{ NORMAL }}'
    @echo "  No auto-fix configured for Android Gradle sources"

# validate Android lint checks (requires generated types)
check: typegen
    @echo '{{ style("command") }}check:{{ NORMAL }}'
    {{ gradlew }} --no-daemon :app:lintDebug

# package the shared library and BoltFFI Kotlin bindings
[working-directory('../shared')]
package: install-targets
    @echo '{{ style("command") }}package:{{ NORMAL }}'
    boltffi pack android

# generate Kotlin app types
[unix]
typegen: package
    @echo '{{ style("command") }}typegen:{{ NORMAL }}'
    RUST_LOG=info cargo run \
        --package shared \
        --bin codegen \
        --features codegen,facet_typegen \
        -- \
            --language kotlin \
            --output-dir generated

[windows]
[script('powershell')]
typegen: package
    Write-Host "{{ style("command") }}typegen:{{ NORMAL }}"
    $env:RUST_LOG='info'
    cargo run --package shared --bin codegen --features codegen,facet_typegen -- --language kotlin --output-dir generated

# build the Android debug APK (generates types first)
build: typegen
    @echo '{{ style("command") }}build:{{ NORMAL }}'
    {{ gradlew }} --no-daemon :app:assembleDebug

# run Android JVM unit tests
test:
    @echo '{{ style("command") }}test:{{ NORMAL }}'
    {{ gradlew }} --no-daemon :app:testDebugUnitTest

# remove build artifacts
[unix]
clean:
    @echo '{{ style("command") }}clean:{{ NORMAL }}'
    {{ gradlew }} --no-daemon clean
    rm -rf generated

[windows]
[script('powershell')]
clean:
    Write-Host "{{ style("command") }}clean:{{ NORMAL }}"
    & {{ gradlew }} --no-daemon clean
    if (Test-Path generated) { Remove-Item -Recurse -Force generated }

# local development workflow
dev: fix check build test

# CI workflow
ci: check build test

# open in Android Studio
open:
    @just lib::open-android-studio
