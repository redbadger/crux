set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

mod lib '../../../lib.just'

default: dev

# --------------------------------------------------------------------------
# Development
# --------------------------------------------------------------------------

# checks required tools are installed
doctor:
    @echo '{{ style("command") }}doctor:{{ NORMAL }}'
    @just lib::check-tool cargo "https://rustup.rs"
    @just lib::check-tool node "https://nodejs.org"
    @just lib::check-tool pnpm "npm install -g pnpm"
    @just lib::check-tool tauri "pnpm add -g @tauri-apps/cli"

# auto-fix lint and formatting issues
fix: install
    @echo '{{ style("command") }}fix:{{ NORMAL }}'
    pnpm exec oxlint --fix
    pnpm exec oxfmt

# validate lint with type-aware Oxlint (warnings do not fail the check, but
# errors do), and validate formatting with oxfmt
check: install
    @echo '{{ style("command") }}check:{{ NORMAL }}'
    pnpm exec oxlint
    pnpm exec oxfmt --check

# install npm dependencies
install:
    @echo '{{ style("command") }}install:{{ NORMAL }}'
    pnpm install

# build the project
build: install
    @echo '{{ style("command") }}build:{{ NORMAL }}'
    pnpm tauri build

# run tests
test:
    @echo '{{ style("command") }}test:{{ NORMAL }}'
    @echo "  No tests configured"

# clean build artifacts
[unix]
clean:
    @echo '{{ style("command") }}clean:{{ NORMAL }}'
    cargo clean
    rm -rf node_modules dist

[windows]
[script('powershell')]
clean:
    $ErrorActionPreference = 'Stop'
    Write-Host "{{ style("command") }}clean:{{ NORMAL }}"
    cargo clean
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    foreach ($path in "node_modules", "dist") {
        if (Test-Path $path) { Remove-Item -Recurse -Force $path }
    }

# update pnpm dependencies to latest
update-pnpm-deps:
    @echo '{{ style("command") }}update-pnpm-deps:{{ NORMAL }}'
    pnpm update


# local development workflow
dev: fix check build test

# CI workflow
ci: install check test
    @echo '{{ style("command") }}build:{{ NORMAL }}'
    pnpm tauri build --no-bundle

# serve the app locally
serve: install
    @echo '{{ style("command") }}serve:{{ NORMAL }}'
    pnpm tauri dev
