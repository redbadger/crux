mod lib '../lib.just'

default: dev

set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

examples := "counter counter-http counter-middleware counter-routing notes weather"

# checks required tools across all examples
[unix]
[script('bash')]
doctor:
    for example in {{ examples }}; do
        echo '{{ style("command") }}'"$example"':{{ NORMAL }}'
        just "$example/doctor"
        echo ''
    done

[windows]
[script('powershell')]
doctor:
    foreach ($example in "{{ examples }}".Split(" ")) {
        if ($example) {
            Write-Host "{{ style("command") }}${example}:{{ NORMAL }}"
            just "$example/doctor"
            Write-Host ""
        }
    }

# local development workflow
[unix]
[script('bash')]
dev:
    set -euo pipefail
    for example in {{ examples }}; do
        echo '{{ style("command") }}'"$example"'/dev:{{ NORMAL }}'
        just "$example/dev"
    done

[windows]
[script('powershell')]
dev:
    foreach ($example in "{{ examples }}".Split(" ")) {
        if ($example) {
            Write-Host "{{ style("command") }}$example/dev:{{ NORMAL }}"
            just "$example/dev"
        }
    }

