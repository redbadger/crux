set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

mod lib '../lib.just'

default: dev

examples := "counter counter-http counter-middleware counter-routing notes weather"

# checks required tools across all examples
[unix]
[script('bash')]
doctor:
    for example in {{ examples }}; do
        echo '{{ style("command") }}'"$example"':{{ NORMAL }}'
        just "$example/doctor"
        echo ''
    done

# no early exit: report every example's tool status, like the bash version
[windows]
[script('powershell')]
doctor:
    foreach ($example in "{{ examples }}".Split(" ")) {
        if ($example) {
            Write-Host "{{ style("command") }}${example}:{{ NORMAL }}"
            just "$example/doctor"
            Write-Host ""
        }
    }

# local development workflow
[unix]
[script('bash')]
dev:
    set -euo pipefail
    for example in {{ examples }}; do
        echo '{{ style("command") }}'"$example"'/dev:{{ NORMAL }}'
        just "$example/dev"
    done

[windows]
[script('powershell')]
dev:
    $ErrorActionPreference = 'Stop'
    foreach ($example in "{{ examples }}".Split(" ")) {
        if ($example) {
            Write-Host "{{ style("command") }}$example/dev:{{ NORMAL }}"
            just "$example/dev"
            if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        }
    }

