# clean build artefacts in all examples
[unix]
[script('bash')]
clean:
    set -euo pipefail
    for example in {{ examples }}; do
        echo '{{ style("command") }}'"$example"'/clean:{{ NORMAL }}'
        just "$example/clean"
    done
    rm -rf */target */*/target
    rm -rf */*/build */*/dist */*/.next */*/.react-router */*/node_modules */*/.gradle

[windows]
[script('powershell')]
clean:
    foreach ($example in "{{ examples }}".Split(" ")) {
        if ($example) {
            Write-Host "{{ style("command") }}$example/clean:{{ NORMAL }}"
            just "$example/clean"
        }
    }
    Get-ChildItem -Path * -Include target -Recurse -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
    Get-ChildItem -Path *\* -Include target,build,dist,.next,.react-router,node_modules,.gradle -Recurse -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue

# update Cargo lockfiles in all examples
[unix]
[script('bash')]
update:
    set -euo pipefail
    for example in {{ examples }}; do
        echo '{{ style("command") }}'"$example"'/update:{{ NORMAL }}'
        (cd "$example" && cargo update)
    done

[windows]
[script('powershell')]
update:
    foreach ($example in "{{ examples }}".Split(" ")) {
        if ($example) {
            Write-Host "{{ style("command") }}$example/update:{{ NORMAL }}"
            Push-Location $example
            cargo update
            Pop-Location
        }
    }

# upgrade Cargo dependency constraints and update lockfiles in all examples
[unix]
[script('bash')]
update-deps:
    set -euo pipefail
    for example in {{ examples }}; do
        echo '{{ style("command") }}'"$example"'/update-deps:{{ NORMAL }}'
        (cd "$example" && cargo upgrade --incompatible allow && cargo update)
    done

[windows]
[script('powershell')]
update-deps:
    foreach ($example in "{{ examples }}".Split(" ")) {
        if ($example) {
            Write-Host "{{ style("command") }}$example/update-deps:{{ NORMAL }}"
            Push-Location $example
            cargo upgrade --incompatible allow
            cargo update
            Pop-Location
        }
    }

# update pnpm dependencies in all examples
[unix]
[script('bash')]
update-pnpm-deps:
    set -euo pipefail
    for example in {{ examples }}; do
        echo '{{ style("command") }}'"$example"'/update-pnpm-deps:{{ NORMAL }}'
