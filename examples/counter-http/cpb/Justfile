mod lib '../../../lib.just'
import '../../../examples_support/cpb-softdevice.just'

default: dev

target := "thumbv7em-none-eabihf"
# heap-probe/.cargo/config.toml pins a host target to override this crate's thumb target;
# pass the actual host so it runs anywhere.
host := `rustc -vV | sed -n 's/^host: //p'`
# The Chrome gateway that performs the firmware's HTTP and SSE (its own workspace).
gateway := "../../../examples_support/ble_gateway"

# --------------------------------------------------------------------------
# Development
# --------------------------------------------------------------------------

# checks required tools are installed (here and for the gateway)
doctor:
    @echo '{{ style("command") }}doctor:{{ NORMAL }}'
    @just lib::check-tool cargo "https://rustup.rs"
    @just lib::check-rust-target {{ target }}
    @just lib::check-tool cargo-objcopy "rustup component add llvm-tools && cargo install cargo-binutils"
    @just lib::check-tool python3 "https://www.python.org"
    @just lib::check-tool curl "your package manager"
    @just lib::check-tool node "https://nodejs.org (for just heap-probe-wasm)"
    @just lib::check-rust-target wasm32-wasip1
    @echo '{{ style("command") }}gateway:{{ NORMAL }}'
    @just {{ gateway }}/doctor

# auto-fix formatting issues
fix:
    @echo '{{ style("command") }}fix:{{ NORMAL }}'
    cargo fmt
    cd heap-probe && cargo fmt

# validate formatting and lint
check:
    @echo '{{ style("command") }}check:{{ NORMAL }}'
    cargo fmt -- --check
    cargo clippy --release --bins -- --no-deps -Dclippy::pedantic -Dclippy::nursery -Dwarnings
    cd heap-probe && cargo fmt -- --check
    cd heap-probe && cargo clippy --target {{ host }} -- --no-deps -Dclippy::pedantic -Dclippy::nursery -Dwarnings

# build all three binaries: cpb-counter-http, link-check, ble-probe (sd: v6 for S140 6.1.1, the default, or v7 for S140 7.x)
build sd="v6":
    @echo '{{ style("command") }}build:{{ NORMAL }}'
    cargo build --release --bins $({{ just_executable() }} _sd-features {{ sd }})

# show a binary's section sizes
size bin="cpb-counter-http" sd="v6": (build sd)
    cargo size --release $({{ just_executable() }} _sd-features {{ sd }}) --bin {{ bin }}

# run the heap probe on the host (the counter-http core, counting allocations; 64-bit
# pointers, so an upper bound)
heap-probe:
    @echo '{{ style("command") }}heap-probe:{{ NORMAL }}'
    cd heap-probe && cargo run --release --target {{ host }}

# run the heap probe as 32-bit wasm under Node (4-byte pointers, as on the nRF52840)
heap-probe-wasm:
    @echo '{{ style("command") }}heap-probe-wasm:{{ NORMAL }}'
    cd heap-probe && cargo build --release --target wasm32-wasip1
    node --no-warnings heap-probe/run-wasi.mjs heap-probe/target/wasm32-wasip1/release/cpb-counter-http-heap-probe.wasm

# serve the gateway (examples_support/ble_gateway) at http://127.0.0.1:8080
serve:
    just {{ gateway }}/serve

# run tests (the core is tested in ../shared, the protocol and gateway in examples_support)
test:
    @echo '{{ style("command") }}test:{{ NORMAL }}'
    @echo "  No tests configured for the firmware (try: just heap-probe)"

# clean build artifacts
clean:
    @echo '{{ style("command") }}clean:{{ NORMAL }}'
    cargo clean
    cd heap-probe && cargo clean

# local development workflow
dev: fix check build test

# CI workflow
ci: check build test

# --------------------------------------------------------------------------
# Flashing (Adafruit UF2 bootloader)
# --------------------------------------------------------------------------

# make target/<bin>.uf2 (bin: cpb-counter-http, link-check or ble-probe. sd: auto reads the board, or v6 or v7)
[script('bash')]
uf2 bin="cpb-counter-http" sd="auto": _uf2-tools
    set -euo pipefail
    echo '{{ style("command") }}uf2:{{ NORMAL }}'
    layout=$({{ just_executable() }} _sd-layout {{ sd }} report)
    if [ "$layout" = v7 ]; then base=0x27000; features='--no-default-features --features sd-v7'; else base=0x26000; features=''; fi
    cargo build --release --bins $features
    cargo objcopy --release $features --bin {{ bin }} -- -O binary target/{{ bin }}.bin
    echo "  UF2 base $base ($layout)"
    python3 -I {{ uf2_tools }}/uf2conv.py target/{{ bin }}.bin -c -b "$base" -f {{ uf2_family }} -o target/{{ bin }}.uf2

# copy a binary's UF2 to the board (double-press reset first, so CPLAYBTBOOT is mounted). sd: auto, v6 or v7
[script('bash')]
flash bin="cpb-counter-http" sd="auto": (uf2 bin sd)
    set -euo pipefail
    echo '{{ style("command") }}flash:{{ NORMAL }}'
    if [ ! -d '{{ drive }}' ]; then
        echo '  {{ style("error") }}✗ {{ drive }} is not mounted{{ NORMAL }}: double-press the reset button, or set CPB_DRIVE'
        exit 1
    fi
    # The board resets as soon as it has the image, so the copy may report an error writing
    # metadata afterwards (macOS: extended attributes); -X skips those there.
    if [ '{{ os() }}' = macos ]; then cp -X target/{{ bin }}.uf2 '{{ drive }}/'; else cp target/{{ bin }}.uf2 '{{ drive }}/'; fi
    echo '  ✓ flashed {{ bin }}; the board resets into it'
