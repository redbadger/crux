mod lib '../../lib.just'

default: dev

# the host workspace (app, protocol, heap-probe) is handled here; these have their own Justfiles
parts := "firmware gateway"

# --------------------------------------------------------------------------
# Development
# --------------------------------------------------------------------------

# checks required tools, here and in firmware/ and gateway/
[script('bash')]
doctor:
    echo '{{ style("command") }}doctor:{{ NORMAL }}'
    just lib::check-tool cargo "https://rustup.rs"
    just lib::check-tool node "https://nodejs.org (for just heap-probe-wasm)"
    just lib::check-rust-target wasm32-wasip1
    for part in {{ parts }}; do
        echo '{{ style("command") }}'"$part"':{{ NORMAL }}'
        just "$part/doctor"
    done

# auto-fix formatting issues everywhere
[script('bash')]
fix:
    set -euo pipefail
    echo '{{ style("command") }}fix:{{ NORMAL }}'
    cargo fmt -p cpb-counter-http-app -p cpb-protocol -p cpb-counter-http-heap-probe
    for part in {{ parts }}; do just "$part/fix"; done

# validate formatting and lint everywhere (app and protocol also for thumbv7em)
[script('bash')]
check:
    set -euo pipefail
    echo '{{ style("command") }}check:{{ NORMAL }}'
    cargo fmt -p cpb-counter-http-app -p cpb-protocol -p cpb-counter-http-heap-probe -- --check
    cargo clippy --workspace --all-targets -- --no-deps -Dclippy::pedantic -Dclippy::nursery -Dwarnings
    cargo clippy -p cpb-counter-http-app -p cpb-protocol --target thumbv7em-none-eabihf -- --no-deps -Dclippy::pedantic -Dclippy::nursery -Dwarnings
    for part in {{ parts }}; do just "$part/check"; done

# build the firmware and the gateway
[script('bash')]
build:
    set -euo pipefail
    for part in {{ parts }}; do just "$part/build"; done

# run the host tests (app, protocol) and the gateway core's
[script('bash')]
test:
    set -euo pipefail
    echo '{{ style("command") }}test:{{ NORMAL }}'
    cargo test --workspace
    for part in {{ parts }}; do just "$part/test"; done

# run the heap probe on the host (64-bit pointers: an upper bound)
heap-probe:
    @echo '{{ style("command") }}heap-probe:{{ NORMAL }}'
    cargo run --release -p cpb-counter-http-heap-probe

# run the heap probe as 32-bit wasm under Node (the numbers in SPIKE_NOTES)
heap-probe-wasm:
    @echo '{{ style("command") }}heap-probe-wasm:{{ NORMAL }}'
    cargo build --release -p cpb-counter-http-heap-probe --target wasm32-wasip1
    node --no-warnings heap-probe/run-wasi.mjs target/wasm32-wasip1/release/cpb-counter-http-heap-probe.wasm

# flash a firmware binary (default: the counter app)
flash bin="cpb-counter-http":
    just firmware/flash {{ bin }}

# serve the gateway at http://127.0.0.1:8080
serve:
    just gateway/serve

# clean build artifacts everywhere
[script('bash')]
clean:
    set -euo pipefail
    for part in {{ parts }}; do just "$part/clean"; done
    cargo clean

# local development workflow
dev: fix check build test

# CI workflow
ci: check build test
