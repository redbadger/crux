mod lib '../lib.just'

default: dev

# check required docs tooling
doctor:
    @echo '{{ style("command") }}doctor:{{ NORMAL }}'
    @just lib::require-tool mdbook "cargo install mdbook"
    @just lib::require-tool mdbook-admonish "cargo install mdbook-admonish"
    @just lib::require-tool mdbook-linkcheck "cargo install mdbook-linkcheck"
    @just lib::require-tool mdbook-mermaid "cargo install mdbook-mermaid --version 0.14.0"

# build the book with configured preprocessors/checkers
build:
    @echo '{{ style("command") }}build:{{ NORMAL }}'
    mdbook build

# remove generated output
clean:
    @echo '{{ style("command") }}clean:{{ NORMAL }}'
    rm -rf book

# local development workflow
dev: build

# Fail if any `{{#include path:anchor}}` in the book names a file or anchor that does not exist.
#
# mdBook only warns about a missing anchor, and includes nothing, so a renamed
# or deleted `ANCHOR` in an example silently blanks a code listing in the book.
# Paths resolve relative to the including page; line-range includes (`:N`,
# `:N:M`) have no anchor to check, so they only need the file to exist.
[script('bash')]
check-includes:
    set -euo pipefail
    echo '{{ style("command") }}check-includes:{{ NORMAL }}'

    status=0
    checked=0
    while IFS= read -r hit; do
        [ -n "$hit" ] || continue
        page=${hit%%:*}
        spec=$(printf '%s' "${hit#*:}" | sed -E 's/^[{][{]#(rustdoc_)?include +//; s/ *[}][}]$//')
        path=${spec%%:*}
        anchor=
        if [ "$path" != "$spec" ]; then
            anchor=${spec#*:}
        fi
        checked=$((checked + 1))
        target="$(dirname "$page")/$path"
        if [ ! -f "$target" ]; then
            echo "  {{ style("error") }}✗ $page includes $path, which does not exist{{ NORMAL }}"
            status=1
        elif [[ "$anchor" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] && ! grep -qE "ANCHOR: ${anchor}( |\$)" "$target"; then
            echo "  {{ style("error") }}✗ $page includes $path:$anchor, but $path has no such anchor{{ NORMAL }}"
            status=1
        fi
    done <<INCLUDES
    $(grep -rHoE '[{][{]#(rustdoc_)?include [^}]*[}][}]' src --include='*.md' || true)
    INCLUDES

    if [ "$checked" -lt 100 ]; then
        echo "  {{ style("error") }}✗ only found $checked includes, expected at least 100 — has the book moved?{{ NORMAL }}"
        status=1
    fi

    if [ "$status" -eq 0 ]; then
        echo "  ✓ $checked includes resolve"
    fi
    exit $status

# CI workflow
ci: build check-includes

# serve the book locally
serve:
    @echo '{{ style("command") }}serve:{{ NORMAL }}'
    mdbook serve
