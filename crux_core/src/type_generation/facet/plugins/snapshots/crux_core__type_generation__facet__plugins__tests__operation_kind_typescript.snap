/// How many times the shell is expected to resolve a request:
/// `notify` never, `request` exactly once, `stream` any number of times.
export type OperationKind = "notify" | "request" | "stream";

/// How many times the shell resolves a request carrying this effect,
/// or `undefined` when the operation leaves that to the call site.
export function effectOperationKind(effect: Effect): OperationKind | undefined {
    switch (effect.kind) {
        case "Render": return "notify";
        case "Http": return "request";
        case "Subscribe": return "stream";
        case "Legacy": return undefined;
        default: return undefined;
    }
}
