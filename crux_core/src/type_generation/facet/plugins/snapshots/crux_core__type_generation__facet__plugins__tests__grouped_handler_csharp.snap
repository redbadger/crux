/// <summary>
/// Receives the items of a streaming effect. Every item sent
/// is one resolution of the request that started the stream.
/// </summary>
public interface IEffectSink<in T>
{
    void Send(T item);
}

/// <summary>
/// Handles the effects of <c>Effect</c> in the <c>Network</c> group.
/// </summary>
public interface INetworkHandler
{
    /// <summary>
    /// Fetch `url`.
    ///
    /// The handler method for this operation carries this doc, in each language.
    /// </summary>
    Task<HttpResult> Http(HttpRequest operation);
}

/// <summary>
/// Handles the effects of <c>Effect</c> in the <c>Store</c> group.
/// </summary>
public interface IStoreHandler
{
    /// <summary>
    /// Receive a message each time one arrives.
    /// </summary>
    void Subscribe(Subscribe operation, IEffectSink<Message> sink);
}

/// <summary>
/// Handles the effects of <c>Effect</c> that are in no group.
/// </summary>
public interface IUngroupedHandler
{
    void Legacy(LegacyOperation operation, uint requestId, Action<byte[]> resolve);
}

/// <summary>
/// Handles every effect <c>Effect</c> can carry.
///
/// <c>EffectDispatcher</c> resolves each request for you, so there is
/// no <c>resolve</c> to call at the wrong time or with the wrong bytes.
///
/// The methods are in the group interfaces that this interface inherits.
/// </summary>
public interface IEffectHandler : INetworkHandler, IStoreHandler, IUngroupedHandler
{
    /// <summary>
    /// <c>Core</c> handles <c>Render</c> itself, so this does nothing;
    /// implement it only if you drive <c>EffectDispatcher</c> yourself.
    /// </summary>
    void Render(RenderOperation operation) { }
}

/// <summary>
/// An <c>IEffectHandler</c> made from one handler for each group. Each
/// method forwards to the handler of its group.
/// </summary>
public sealed class GroupedEffectHandler : IEffectHandler
{
    private readonly INetworkHandler _network;
    private readonly IStoreHandler _store;
    private readonly IUngroupedHandler _ungrouped;

    public GroupedEffectHandler(INetworkHandler network, IStoreHandler store, IUngroupedHandler ungrouped)
    {
        _network = network;
        _store = store;
        _ungrouped = ungrouped;
    }

    public Task<HttpResult> Http(HttpRequest operation) => _network.Http(operation);

    public void Subscribe(Subscribe operation, IEffectSink<Message> sink) => _store.Subscribe(operation, sink);

    public void Legacy(LegacyOperation operation, uint requestId, Action<byte[]> resolve) => _ungrouped.Legacy(operation, requestId, resolve);
}

/// <summary>
/// Routes each request to an <c>IEffectHandler</c> and resolves it for
/// you: never for a notification, once for a request, once per item
/// for a stream.
/// </summary>
public sealed class EffectDispatcher
{
    private readonly IEffectHandler _handler;
    private readonly Action<uint, byte[]> _resolve;

    public EffectDispatcher(IEffectHandler handler, Action<uint, byte[]> resolve)
    {
        _handler = handler;
        _resolve = resolve;
    }

    public void Dispatch(Shared.Request request)
    {
        var id = request.Id;
        switch (request.Effect)
        {
            case Shared.Effect.Render render:
                _handler.Render(render.Value);
                break;
            case Shared.Effect.Http http:
                _ = DispatchHttp(http.Value, id);
                break;
            case Shared.Effect.Subscribe subscribe:
                _handler.Subscribe(subscribe.Value, new DelegateEffectSink<Message>(item =>
                {
                    var serializer = new BincodeSerializer();
                    item.Serialize(serializer);
                    _resolve(id, serializer.GetBytes());
                }));
                break;
            case Shared.Effect.Legacy legacy:
                _handler.Legacy(legacy.Value, id, bytes => _resolve(id, bytes));
                break;
        }
    }

    private async Task DispatchHttp(HttpRequest operation, uint id)
    {
        var output = await _handler.Http(operation);
        var serializer = new BincodeSerializer();
        output.Serialize(serializer);
        _resolve(id, serializer.GetBytes());
    }

    private sealed class DelegateEffectSink<T> : IEffectSink<T>
    {
        private readonly Action<T> _send;

        public DelegateEffectSink(Action<T> send)
        {
            _send = send;
        }

        public void Send(T item)
        {
            _send(item);
        }
    }
}
