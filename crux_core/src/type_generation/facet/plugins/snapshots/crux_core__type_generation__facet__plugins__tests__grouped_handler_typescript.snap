/**
 * Receives the items of a streaming effect.
 *
 * Every item sent is one resolution of the request that started the stream.
 */
export interface EffectSink<T> {
    send(item: T): void;
}

/** Handles the effects of `Effect` in the `Network` group. */
export interface NetworkHandler {
    /**
     * Fetch `url`.
     *
     * The handler method for this operation carries this doc, in each language.
     */
    http(operation: HttpRequest): Promise<HttpResult>;
}

/** Handles the effects of `Effect` in the `Store` group. */
export interface StoreHandler {
    /** Receive a message each time one arrives. */
    subscribe(operation: Subscribe, sink: EffectSink<Message>): void;
}

/** Handles the effects of `Effect` that are in no group. */
export interface UngroupedHandler {
    legacy(operation: LegacyOperation, requestId: uint32, resolve: (bytes: Uint8Array) => void): void;
}

/**
 * Handles every effect `Effect` can carry.
 *
 * `EffectDispatcher` resolves each request for you, so there is no
 * `resolve` to call at the wrong time or with the wrong bytes.
 *
 * The methods are in the group interfaces that this interface extends.
 */
export interface EffectHandler extends NetworkHandler, StoreHandler, UngroupedHandler {
    /**
     * `Core` handles `Render` itself, so this is optional; implement it
     * only if you drive `EffectDispatcher` yourself.
     */
    render?(operation: RenderOperation): void;
}

/**
 * An `EffectHandler` made from one handler for each group. Each method
 * forwards to the handler of its group.
 */
export class GroupedEffectHandler implements EffectHandler {
    private readonly _network: NetworkHandler;
    private readonly _store: StoreHandler;
    private readonly _ungrouped: UngroupedHandler;

    constructor(
        network: NetworkHandler,
        store: StoreHandler,
        ungrouped: UngroupedHandler,
    ) {
        this._network = network;
        this._store = store;
        this._ungrouped = ungrouped;
    }

    http(operation: HttpRequest): Promise<HttpResult> {
        return this._network.http(operation);
    }

    subscribe(operation: Subscribe, sink: EffectSink<Message>): void {
        this._store.subscribe(operation, sink);
    }

    legacy(operation: LegacyOperation, requestId: uint32, resolve: (bytes: Uint8Array) => void): void {
        this._ungrouped.legacy(operation, requestId, resolve);
    }
}

/**
 * Routes each request to an `EffectHandler` and resolves it for you:
 * never for a notification, once for a request, once per item for a
 * stream.
 */
export class EffectDispatcher {
    constructor(
        private readonly handler: EffectHandler,
        private readonly resolve: (id: uint32, bytes: Uint8Array) => void,
    ) {}

    public dispatch(request: Request): void {
        const id = request.id;
        const effect = request.effect;
        switch (effect.kind) {
            case "Render": {
                this.handler.render?.(effect.value);
                break;
            }
            case "Http": {
                void this.handler.http(effect.value).then((output) => {
                    const serializer = new BincodeSerializer();
                    serializeHttpResult(output, serializer);
                    this.resolve(id, serializer.getBytes());
                });
                break;
            }
            case "Subscribe": {
                this.handler.subscribe(effect.value, {
                    send: (item) => {
                        const serializer = new BincodeSerializer();
                        item.serialize(serializer);
                        this.resolve(id, serializer.getBytes());
                    },
                });
                break;
            }
            case "Legacy": {
                this.handler.legacy(effect.value, id, (bytes) => this.resolve(id, bytes));
                break;
            }
        }
    }
}
